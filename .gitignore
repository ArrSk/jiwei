node_modules/
dist/
dist-ssr/
build/
coverage/
*.local

# 根目录的本地数据（IndexedDB 导出 / 备份）。
# 必须写前导斜杠：不带斜杠的 `data/` 会匹配任意层级的 data 目录，
# 从而把 packages/data（源码包！）一并忽略掉。这个坑已经踩过一次。
/data/
*.db
*.db-journal

# 原生外壳构建产物（Capacitor，M5 起）
/android/
/ios/
.capacitor/

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 本地验证输出（scripts/verify.ps1 的产物）
verify-report.txt
